# Copy this file to .env and replace the placeholder with your private key.
# Never commit the .env file.
RAWG_API_KEY=
SECRET_KEY=replace-with-a-random-development-secret
DATABASE_URL=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# A6: server-side Steam Web API key; users never enter this key.
STEAM_WEB_API_KEY=
# Must match the browser origin exactly. Use HTTPS outside local development.
PUBLIC_BASE_URL=http://127.0.0.1:5000
# Steam linking requires a private random SECRET_KEY of at least 32 characters.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
